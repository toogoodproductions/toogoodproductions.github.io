# Windows / macOS junk
Thumbs.db
desktop.ini
.DS_Store
*.tmp

# Source films stay local - only what the tools generate is committed.
# Ignoring the folder's own files rather than a list of extensions, so a
# master dropped in as .mov, .superseded or anything else is covered too.
*.mov
assets/video/*
!assets/video/loops/
!assets/video/films/
!assets/video/stills/
!assets/video/products/
!assets/video/.gitkeep

# Original founder portraits as supplied. The square crops the site uses
# live in test3/assets/img/team/.
assets/Founders Photos/

# Local review page, not part of the site
_preview.html

# Local dev server config
.claude/

# Local comparison files, not part of the site
_review/
