# Windows / macOS junk
Thumbs.db
desktop.ini
.DS_Store
*.tmp

# Source films stay local - only what the tools generate is committed.
# Ignoring the folder's own files rather than a list of extensions, so a
# master dropped in as .mov, .superseded or anything else is covered too.
*.mov
assets/video/*
!assets/video/loops/
!assets/video/films/
!assets/video/stills/
!assets/video/products/
!assets/video/.gitkeep

# Original founder portraits as supplied. The square crops the site uses
# live in assets/img/team/.
assets/Founders Photos/

# Local review page, not part of the site
_preview.html

# Local dev server config
.claude/

# Local comparison files, not part of the site
_review/

# Apna Ghar / Adani Realty came off the site on 15 September 2026. The files
# stay on the local machine deliberately - these rules only stop them being
# published again, by a stray `git add -A` or by make-logos.py regenerating
# the logo from the source that is still in the folder.
assets/Logo (Brand)/Adani Realty.png
assets/img/logos/adani-realty.png
assets/video/films/apna-ghar-adani-realty.*
assets/video/loops/apna-ghar-adani-realty.*
assets/video/stills/apna-ghar-adani-realty/
